<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect non-www to canonical www HTTPS
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^xpresswasteremoval\.co\.uk$ [NC]
  RewriteRule ^(.*)$ https://www.xpresswasteremoval.co.uk/$1 [L,R=301]

  # Serve existing static files directly (robots.txt, sitemap.xml, llms.txt, assets, images)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA fallback for clean SEO URLs (/services/*, /areas/*, /quote)
  RewriteRule ^ /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Security & Best-Practices headers
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Cross-Origin-Opener-Policy "same-origin"

  # 1-year immutable caching for hashed Vite assets and static images
  <FilesMatch "\.(js|css|webp|png|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>
