# Copy this file to ".env" for local development and fill in real values.
# On Vercel, add the same names under Project Settings -> Environment Variables.
# Never commit the real .env file.

# Supabase project URL (Supabase -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon (public) key (Supabase -> Project Settings -> API)
VITE_SUPABASE_ANON_KEY=your-anon-public-key
